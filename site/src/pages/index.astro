---
// The home page answers what the app is, what it looks like and where to get
// it, and leaves the depth to the pages under it: each idea is said once, in a
// sentence, with a link to the page that goes further.
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import DownloadButton from "../components/DownloadButton.astro";
import LabourEmblem from "../components/LabourEmblem.astro";
import Showcase from "../components/Showcase.astro";
import icon from "../../../build/icon-256.png";
import { LABOURS } from "../../../src/records/labours";
import { LOCALES } from "../../../src/i18n/locales";
import { latestRelease } from "../release.mjs";
import { softwareApplication } from "../structuredData.mjs";

const release = await latestRelease();

// The app's screens, each tab named as the app's sidebar names it.
const screens = [
  {
    label: "Overview",
    shot: "01-overview",
    alt: "Overview: recovery, the week's training, last night's sleep and what is planned next",
    text: "Recovery, last night's sleep and the week's load on one screen. Heart rate, sleep and stress level have screens of their own.",
    href: "/health",
    link: "Health",
  },
  {
    label: "Logbook",
    shot: "04-run",
    alt: "A run: map, pace, heart rate, running form and every channel",
    text: "Every run, ride, hike, swim and climb, with every channel the watch recorded and charts that answer a question.",
    href: "/activities/",
    link: "Every sport",
  },
  {
    label: "Strength",
    shot: "07-strength",
    alt: "Strength: sessions and a 3D muscle map",
    text: "COROS strength sessions and Hevy workouts together, every set on the muscles it worked.",
    href: "/activities/strength/",
    link: "Strength",
  },
  {
    label: "Plan",
    shot: "09-calendar",
    alt: "Calendar: planned and completed sessions by month",
    text: "Your COROS calendar, workouts and plans. What you build or move here is saved to COROS, so your watch has it.",
    href: "/plan/",
    link: "Plan & Library",
  },
  {
    label: "Library",
    shot: "29-exercises-library",
    alt: "Exercises Library: a goblet squat with its clip and the muscles it works",
    text: "COROS's whole movement catalogue by body part, muscle or equipment, each movement with its clip and the muscles it really works.",
    href: "/plan/exercises",
    link: "Exercises Library",
  },
  {
    label: "Mentor",
    shot: "11-coach",
    alt: "Mentor: an interval session analysed, with heart-rate and pace charts",
    text: "Ask about a session, a week or your recovery. Answers come with the numbers and charts behind them.",
    href: "/mentor",
    link: "Mentor",
  },
  {
    label: "Journey",
    shot: "14-timeline",
    alt: "Hall of Records: the timeline of milestones",
    text: "Every first, record and streak, kept month by month, and every place your training has taken you.",
    href: "/labours",
    link: "Hall of Records",
  },
];

const facts = [
  { title: "Free and open source", text: "MIT licensed." },
  { title: "Any COROS watch", text: "PACE, APEX, VERTIX, NOMAD and the rest." },
  { title: "macOS, Windows, Linux", text: "One app on every computer you train from." },
  { title: `In ${LOCALES.length} languages`, text: "Every screen, Mentor included.", href: "/guide/customise#language" },
];

const reasons = [
  {
    title: "Strength, counted properly.",
    text: "COROS scores lifting by heart rate, so an hour of heavy squats can count for less than a short jog. Heracles Records scores every set from the weight, the reps and how close to failure it went, on the same scale as your runs.",
    href: "/activities/strength/training-load",
    link: "How the formula works",
  },
  {
    title: "A mentor that proposes, never decides.",
    text: "It runs on the AI you already have: your ChatGPT account, a Claude subscription, an API key or a model on your own computer. Changes to your week arrive as a list you apply one line at a time.",
    href: "/mentor",
    link: "How Mentor works",
  },
  {
    title: "Your training stays yours.",
    text: "The app has no account of its own and the developer runs no servers. Sync two computers through your own Google Drive, or keep everything in one backup file.",
    href: "/privacy.html",
    link: "Privacy policy",
  },
];

const steps = ["Download", "Sign in with COROS", "Pick an AI for Mentor, if you like"];
---

<Base jsonLd={softwareApplication(release, Astro.site)} description="Heracles Records is a free desktop app for COROS athletes: every session read in depth, an AI mentor that has read all of it, and a hall for every record you set.">
  <section class="hero wrap">
    <Image class="hero-icon" src={icon} alt="" width={88} height={88} densities={[1, 2]} format="webp" loading="eager" />
    <h1>Your COROS training, read in depth.</h1>
    <p class="hero-tagline">Every session a record. Every record a labour.</p>
    <p class="hero-lede">
      A free desktop app for COROS athletes, with an AI mentor that knows your training and a
      hall for every record you set.
    </p>
    <div class="hero-download">
      <DownloadButton list={false} />
      <a class="hero-installers" href="/download">
        {release ? `Every installer for version ${release.version}` : "Every installer"}
      </a>
    </div>
  </section>

  <section class="wrap" aria-label="The app">
    <Showcase label="The app's screens" tabs={screens} />
  </section>

  <section class="wrap" aria-label="At a glance">
    <ul class="facts">
      {
        facts.map((fact) => (
          <li>
            <strong>{fact.href ? <a href={fact.href}>{fact.title}</a> : fact.title}</strong>
            <span>{fact.text}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap reasons" aria-label="What sets it apart">
    {
      reasons.map((reason) => (
        <div>
          <h2>{reason.title}</h2>
          <p>{reason.text}</p>
          <a class="more" href={reason.href}>{reason.link}</a>
        </div>
      ))
    }
  </section>

  <section class="wrap band">
    <h2 class="section-title">Twelve labours to reach.</h2>
    <p class="band-lede">
      Every first, record and streak is kept. The labours turn them into stages, from your first
      weeks to your first year, with speed and VO₂max graded for your age and sex.
    </p>
    <ul class="emblems">
      {
        LABOURS.map((labour) => (
          <li>
            <a href={`/labours#${labour.id}`} title={labour.short}>
              <LabourEmblem id={labour.id} size={64} />
              <span class="emblem-name">{labour.short}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="more" href="/labours">See every labour and its stages</a>
  </section>

  <section class="wrap band start">
    <h2 class="section-title">Start in three steps.</h2>
    <ol class="steps">
      {steps.map((step) => <li>{step}</li>)}
    </ol>
    <DownloadButton />
    <p class="start-links">
      <a href="/guide/getting-started">Getting started</a> · <a href="/guide/faq">FAQ</a> ·
      <a href="/changelog/">What's new</a>
    </p>
    <div class="coffee">
      <p>
        <strong>Enjoy your training with Heracles Records.</strong> No ads, no subscription and no
        company behind it. If it helps your training, a coffee says it is worth carrying on.
      </p>
      <a class="button" href="https://buymeacoffee.com/quochungse">Buy me a coffee</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    justify-items: center;
    padding-top: 80px;
    padding-bottom: 56px;
    text-align: center;
  }

  .hero-icon {
    width: 88px;
    height: 88px;
    margin-bottom: 28px;
  }

  .hero h1 {
    max-width: 880px;
    margin: 0;
    font: 600 clamp(36px, 6vw, 56px) / 1.15 var(--font-title);
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .hero-tagline {
    margin: 16px 0 0;
    color: var(--accent);
    font: italic 400 18px/1.45 var(--font-title);
  }

  .hero-lede {
    max-width: 560px;
    margin: 20px 0 0;
    color: var(--ink-2);
    font-size: 18px;
    line-height: 1.6;
    text-wrap: balance;
  }

  .hero-download {
    display: grid;
    justify-items: center;
    gap: 14px;
    margin-top: 32px;
  }

  .hero-installers {
    color: var(--ink-3);
    font-size: 14px;
  }

  .hero-installers:hover {
    color: var(--ink-2);
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 72px 0 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: grid;
    align-content: start;
    gap: 4px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .facts strong {
    font-size: 15px;
  }

  .facts strong a {
    color: inherit;
    text-decoration-color: var(--ink-3);
  }

  .facts strong a:hover {
    color: var(--accent);
  }

  .facts span {
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.5;
  }

  .reasons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    padding-top: 80px;
  }

  .reasons div {
    display: grid;
    align-content: start;
  }

  .reasons h2 {
    margin: 0;
    font: 600 24px/1.25 var(--font-title);
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .reasons p {
    margin: 12px 0 0;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .reasons {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 72px;
    }
  }

  /* A centred band: the labours, then the way in. */
  .band {
    display: grid;
    justify-items: center;
    margin-top: 80px;
    padding-top: 80px;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .band-lede {
    max-width: 600px;
    margin: 16px 0 0;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 1.6;
    text-wrap: balance;
  }

  .emblems {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    margin: 40px 0 8px;
    padding: 0;
    list-style: none;
  }

  .emblems li {
    display: grid;
    justify-items: center;
  }

  .emblems a {
    display: grid;
    border-radius: 50%;
    transition: transform 150ms ease;
  }

  .emblems a:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .emblems a {
      transition: none;
    }
  }

  .emblem-name {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .emblems {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: 20px;
    }
  }

  .steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 40px;
    margin: 28px 0 32px;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .steps li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-2);
    font-size: 16px;
    counter-increment: step;
  }

  .steps li::before {
    content: counter(step);
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 14px;
    font-weight: 700;
  }

  .start-links {
    margin: 24px 0 0;
    color: var(--ink-3);
    font-size: 15px;
  }

  .start-links a {
    text-decoration: none;
  }

  .coffee {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 28px;
    max-width: 720px;
    margin-top: 56px;
    padding: 24px 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .coffee p {
    flex: 1 1 320px;
    min-width: 0;
    margin: 0;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.6;
    text-align: left;
  }

  .coffee strong {
    color: var(--ink);
  }

  @media (max-width: 560px) {
    .coffee p {
      text-align: center;
    }
  }
</style>
