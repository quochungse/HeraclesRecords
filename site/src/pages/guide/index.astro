---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const guides = (await getCollection("guide")).sort((a, b) => a.data.order - b.data.order);
---

<Base og="guide" title="Guide" description="How to install Heracles Records, connect COROS, set up Coach, sync two computers and fix what goes wrong.">
  <section class="wrap page-hero">
    <p class="eyebrow">Guide</p>
    <h1>Getting the most out of Heracles Records</h1>
    <p class="lede">From the first launch to a second computer, and what to do when something is not right.</p>
  </section>

  <section class="wrap guide-index">
    <ul class="cards">
      {
        guides.map((guide) => (
          <li class="card">
            <h3>
              <a href={`/guide/${guide.id}`}>{guide.data.title}</a>
            </h3>
            <p>{guide.data.description}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .guide-index {
    padding-top: 40px;
  }

  .card h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  .card h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .card {
    position: relative;
  }

  .card:hover {
    border-color: var(--ink-3);
  }
</style>
