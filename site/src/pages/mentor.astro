---
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";
import { MENTOR_PORTRAIT_PATH } from "../../../src/chat/mentorPortrait";

const reads = [
  { title: "Activities", text: "Every session, its laps, zones, how you rated it on the watch and every channel it recorded, down to one stretch of it: the last 5 km, the third interval." },
  { title: "Load and recovery", text: "Training load and where it is heading, overnight HRV and the heart rate you slept at, steps, exercise minutes and stress, day by day and week by week." },
  { title: "Sleep", text: "Nights, naps, stages, HRV across the night and stress by the hour." },
  { title: "Plans and workouts", text: "Your COROS workout library, your plans and how well you are keeping to them." },
  { title: "Zones and profile", text: "Your own heart-rate, pace and power zones, thresholds and personal records." },
  { title: "The web", text: "Races, events and anything else your data does not hold, when a conversation allows it. Never in an analysis, and a local model does without." },
];

const does = [
  { title: "Answers with charts", text: "Heart rate against pace, a week's load, time in zones: the figures behind the answer, drawn where they belong in it." },
  { title: "Drafts workouts", text: "One session, built to your zones, saved to your COROS library or straight onto your calendar." },
  { title: "Writes plans with you", text: "A plan longer than two weeks starts as a brief you can edit, then an outline, then every session. Read it in the Workbench beside the conversation, change what you like, and save it to COROS." },
  { title: "Rearranges your week", text: "Moves, swaps, removals and additions arrive as a list. Apply them one line at a time, or all at once." },
  { title: "Asks before it guesses", text: "What only you know, a race date or the days you can train, Mentor asks with a card of choices rather than assuming." },
  { title: "Speaks your way", text: "Friendly, Motivating, Neutral, Straight talk or No filter, in whatever language you write to it. Your own instructions go on top." },
];

const providers = [
  { name: "ChatGPT", need: "Your ChatGPT account. You sign in through your browser." },
  { name: "Claude subscription", need: "A paid Claude plan, and Claude Code installed on the computer. The app signs in with a Claude login of its own." },
  { name: "Claude API key", need: "An Anthropic API key. Pay as you go." },
  { name: "OpenRouter", need: "An OpenRouter API key, and any model it offers." },
  { name: "Local model", need: "Ollama or LM Studio running on your computer. Free, and your questions never leave it." },
];
---

<Base og="coach"
  title="Mentor"
  description="Mentor, the AI trainer in Heracles Records, named for the counsellor of the Odyssey: it reads your COROS training, answers with charts, drafts workouts and plans, and changes nothing without you."
>
  <section class="wrap page-hero">
    <p class="eyebrow">Mentor</p>
    <h1>A trainer named Mentor.</h1>
    <p class="lede">
      Mentor is the trainer in Heracles Records, and the name it answers to. Ask about a
      session, a week or how well you are recovering: it reads your COROS data and answers with
      the numbers and the charts behind them. It drafts what you ask for, and changes nothing
      until you say so.
    </p>
  </section>

  <section class="wrap section-tight">
    <Shot name="11-coach" alt="Mentor: an interval session analysed, with heart-rate and pace charts" eager />
  </section>

  <section class="wrap section the-name" id="the-name">
    <svg class="portrait" viewBox="0 0 24 24" aria-hidden="true">
      <path d={MENTOR_PORTRAIT_PATH} fill="currentColor" fill-rule="evenodd" />
    </svg>
    <div>
      <p class="eyebrow">The name</p>
      <h2 class="section-title">Named for the counsellor of the Odyssey.</h2>
      <p class="lede">
        In the Odyssey, Mentor is the friend Odysseus leaves in charge of his house and his son
        when he sails for Troy. When Telemachus sets out to find his father, Athena comes to him
        in Mentor's shape and shows him the way. The name outlived the story: a mentor is now
        anyone who has gone further down the road and helps you along it.
      </p>
      <p class="lede">
        Here it is both. A name, with the old counsellor's portrait on the rail, on every
        <strong>Ask Mentor</strong> button and beside each answer. And the counsellor's job: it
        keeps watch over every session, night and plan your COROS account holds, and it advises.
        The decisions stay yours.
      </p>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2 class="section-title">What Mentor reads</h2>
      <p class="lede">
        Mentor fetches what a question is about, not everything at once, and every figure about
        your training comes from your COROS account.
      </p>
    </div>
    <ul class="cards">
      {
        reads.map((item) => (
          <li class="card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2 class="section-title">What Mentor does</h2>
    </div>
    <ul class="cards">
      {
        does.map((item) => (
          <li class="card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ul>
    <div class="workbench">
      <Shot name="12-coach-plan" alt="Mentor: a marathon plan in the Workbench beside the conversation" />
    </div>
  </section>

  <section class="wrap section" id="auto-analysis">
    <div class="section-head">
      <p class="eyebrow">Auto analysis</p>
      <h2 class="section-title">Mentor checks in on its own.</h2>
      <p class="lede">
        Give a conversation a standing job and Mentor does it without being asked. Open
        <strong>Analyses</strong> at the top of a conversation, start from one of four starting
        points or write your own playbook, and choose when it runs. Each answer lands in that
        conversation, marked as an analysis, ready when you open it.
      </p>
    </div>

    <div class="auto-shot">
      <Shot
        name="24-auto-analysis"
        alt="Creating an auto analysis: post-activity debrief, morning briefing, weekly review, next week's plan or your own"
      />
    </div>

    <div class="auto-grid">
      <div class="card">
        <h3>Start from</h3>
        <ul class="plain">
          <li><strong>Post-activity debrief</strong>: after every activity over 20 minutes, how it went against recent training.</li>
          <li><strong>Morning briefing</strong>: at 07:00, what today should look like.</li>
          <li><strong>Weekly review</strong>: on Sunday evening, what held and what slipped.</li>
          <li><strong>Next week's plan</strong>: on Monday morning, the week's sessions drafted for your approval.</li>
          <li><strong>Write my own</strong>: what to look at and what to say, in your words.</li>
        </ul>
      </div>
      <div class="card">
        <h3>When it runs</h3>
        <ul class="plain">
          <li><strong>After a new activity</strong>: for the sports you pick, over a length or a distance. A debrief also reads the 72 hours before, so yesterday's leg day is part of today's run.</li>
          <li><strong>On a schedule</strong>: every day or every week, at the time you set.</li>
          <li><strong>When a metric turns</strong>: training load ramping, your sleeping heart rate drifting up, a planned workout missed, or sleep debt building.</li>
          <li><strong>Only when you ask</strong>: a playbook you run by hand.</li>
        </ul>
      </div>
      <div class="card">
        <h3>Kept in bounds</h3>
        <ul class="plain">
          <li><strong>Read-only.</strong> An analysis reads and suggests. Workouts and changes it proposes wait for you to apply them.</li>
          <li><strong>Guard rails.</strong> A cooldown, a cap on runs per day and quiet hours.</li>
          <li><strong>A monthly budget</strong> for everything analyses spend, and one switch that pauses them all.</li>
          <li><strong>One computer or any.</strong> With Sync, an analysis runs on whichever of your computers is awake, once. Or keep it to this one.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2 class="section-title">A conversation is yours to shape</h2>
    </div>
    <ul class="ticks">
      <li>
        <strong>Ask from anywhere.</strong> Ask Mentor sits on every session's page, on a
        calendar day or week, and on a plan and its sessions in the Training Library. The
        question arrives already pointing at what it is about.
      </li>
      <li>
        <strong>Edit, delete or hide.</strong> Edit your last question and ask again, delete one
        you regret, or hide a turn from Mentor without losing it.
      </li>
      <li>
        <strong>Branch.</strong> Start a new conversation from any answer to try another idea.
        What Mentor made in the first one stays there.
      </li>
      <li>
        <strong>Long threads.</strong> A rail of your questions takes you back to any of them,
        and Mentor searches its earlier turns when they matter again.
      </li>
    </ul>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2 class="section-title">Pick the AI</h2>
      <p class="lede">
        Mentor runs on an AI you choose, set up under <strong>Settings → Connections → AI Model Providers</strong>.
        Each conversation can use a different one.
      </p>
    </div>
    <div class="table-wrap">
      <table class="providers">
        <thead>
          <tr>
            <th>Provider</th>
            <th>What you need</th>
          </tr>
        </thead>
        <tbody>
          {
            providers.map((provider) => (
              <tr>
                <th scope="row">{provider.name}</th>
                <td>{provider.need}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <a class="more" href="/guide/set-up-mentor">Set up Mentor, step by step</a>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2 class="section-title">You decide what it sees</h2>
    </div>
    <ul class="ticks">
      <li>
        <strong>Sources per conversation.</strong> Switch off activities, sleep or anything else a
        conversation should not read. It is withheld from Mentor's tools and from what it is told,
        not only from the prompt.
      </li>
      <li>
        <strong>Straight to your provider.</strong> Your questions and the data they need go from
        your computer to the AI you picked, and nowhere else. A local model keeps them on your
        computer.
      </li>
      <li>
        <strong>Nothing saved behind your back.</strong> Drafts, plans and changes to your calendar
        wait on a button you press. Automatic analyses can only read.
      </li>
      <li>
        <strong>What each answer cost.</strong> The model and the tokens it used are under every
        answer, and automatic analyses have a monthly budget you set.
      </li>
    </ul>
  </section>
</Base>

<style>
  .section-tight {
    padding-top: 40px;
  }

  .the-name {
    display: grid;
    grid-template-columns: 168px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .portrait {
    display: block;
    width: 168px;
    height: 168px;
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
  }

  @media (max-width: 760px) {
    .the-name {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .portrait {
      width: 104px;
      height: 104px;
      padding: 18px;
    }
  }

  .workbench {
    margin-top: 40px;
  }

  .auto-shot {
    margin-bottom: 32px;
  }

  .auto-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 960px) {
    .auto-grid {
      grid-template-columns: 1fr;
    }
  }

  .plain {
    display: grid;
    gap: 10px;
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.55;
  }

  .plain strong {
    color: var(--ink);
  }

  .table-wrap {
    overflow-x: auto;
  }

  .providers {
    width: 100%;
    border-collapse: collapse;
  }

  .providers th,
  .providers td {
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .providers thead th {
    color: var(--ink-3);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .providers tbody th {
    white-space: nowrap;
    font-weight: 600;
  }

  .providers td {
    color: var(--ink-2);
  }
</style>
