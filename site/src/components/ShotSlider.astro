---
// A few screenshots in one frame, turned by hand: left and right buttons float
// over the picture and a dot per slide sits under it. Nothing moves on its own.
// With reduced motion asked for, a slide swaps at once.
import { getImage } from "astro:assets";
import { shot, SHOT_WIDTHS, SIZES_SIDE } from "../assets";

interface Slide {
  name: string;
  alt: string;
  label: string;
}

interface Props {
  slides: Slide[];
  label: string;
}

const { slides, label } = Astro.props;
const images = await Promise.all(
  slides.map(async (slide) => {
    const image = shot(slide.name);
    const sized = await getImage({
      src: image,
      widths: SHOT_WIDTHS.filter((width) => width < image.width).concat(image.width),
      sizes: SIZES_SIDE,
      format: "webp",
      quality: 82,
    });
    return { ...slide, image, sized };
  }),
);
---

<div class="slider" role="region" aria-roledescription="carousel" aria-label={label}>
  <div class="slider-frame">
    <div class="slider-track">
      {
        images.map((slide, index) => (
          <figure
            class="slider-slide"
            role="group"
            aria-roledescription="slide"
            aria-label={`${index + 1} of ${images.length}: ${slide.label}`}
            aria-hidden={index === 0 ? undefined : "true"}
          >
            <img
              class="shot"
              src={slide.sized.src}
              srcset={slide.sized.srcSet.attribute}
              sizes={SIZES_SIDE}
              width={slide.image.width}
              height={slide.image.height}
              alt={slide.alt}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              draggable="false"
            />
          </figure>
        ))
      }
    </div>
    <button type="button" class="slider-arrow is-prev" aria-label="Previous screenshot" data-step="-1">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
    </button>
    <button type="button" class="slider-arrow is-next" aria-label="Next screenshot" data-step="1">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
    </button>
  </div>
  <div class="slider-dots">
    {
      images.map((slide, index) => (
        <button
          type="button"
          class="slider-dot"
          aria-label={`Show ${slide.label}`}
          aria-current={index === 0 ? "true" : undefined}
          data-index={index}
        />
      ))
    }
  </div>
</div>

<script>
  for (const slider of document.querySelectorAll<HTMLElement>(".slider")) {
    const track = slider.querySelector<HTMLElement>(".slider-track")!;
    const slides = [...slider.querySelectorAll<HTMLElement>(".slider-slide")];
    const dots = [...slider.querySelectorAll<HTMLButtonElement>(".slider-dot")];
    let current = 0;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      track.style.transform = `translateX(-${current * 100}%)`;
      slides.forEach((slide, i) => {
        if (i === current) {
          slide.removeAttribute("aria-hidden");
          slide.querySelector("img")?.setAttribute("loading", "eager");
        } else {
          slide.setAttribute("aria-hidden", "true");
        }
      });
      dots.forEach((dot, i) => {
        if (i === current) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
    };

    for (const arrow of slider.querySelectorAll<HTMLButtonElement>(".slider-arrow")) {
      arrow.addEventListener("click", () => show(current + Number(arrow.dataset.step)));
    }
    dots.forEach((dot, index) => dot.addEventListener("click", () => show(index)));

    // Warm the next slides so the first slide-in is not a blank frame.
    window.addEventListener("load", () =>
      slides.forEach((slide) => slide.querySelector("img")?.setAttribute("loading", "eager")),
    );
  }
</script>

<style>
  .slider-frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shot-shadow);
  }

  .slider-track {
    display: flex;
    transition: transform 600ms cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .slider-slide {
    flex: 0 0 100%;
    margin: 0;
  }

  /* The frame carries the shadow; a shadow per slide would be clipped. */
  .slider-slide :global(.shot) {
    box-shadow: none;
  }

  .slider-arrow {
    position: absolute;
    top: 50%;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 50%;
    background: rgba(5, 8, 11, 0.62);
    color: #f5f5f7;
    cursor: pointer;
    opacity: 0.85;
    transform: translateY(-50%);
    backdrop-filter: blur(6px);
    transition:
      opacity 150ms ease,
      background 150ms ease;
  }

  .slider-arrow:hover {
    opacity: 1;
    background: rgba(5, 8, 11, 0.85);
  }

  .slider-arrow.is-prev {
    left: 12px;
  }

  .slider-arrow.is-next {
    right: 12px;
  }

  .slider-arrow svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .slider-dots {
    display: flex;
    justify-content: center;
    gap: 0;
    margin-top: 8px;
  }

  /* A 24px target (WCAG 2.5.8) drawing an 8px dot. */
  .slider-dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }

  .slider-dot::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ink-3);
    opacity: 0.5;
    transition:
      opacity 150ms ease,
      background 150ms ease;
  }

  .slider-dot[aria-current="true"]::before {
    background: var(--accent);
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .slider-track {
      transition: none;
    }
  }
</style>
