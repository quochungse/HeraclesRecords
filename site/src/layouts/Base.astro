---
import "../../../src/fonts.css";
import "../styles/site.css";
import icon from "../../../build/icon-256.png";
import { formatReleaseDate, latestRelease } from "../release.mjs";

interface Props {
  title?: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title} · Heracles Records` : "Heracles Records";
// GitHub Pages serves coach.html at /coach, so that is the address to share.
const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/");
const canonical = new URL(path, Astro.site);
const repo = "https://github.com/quochungse/HeraclesRecords";
const release = await latestRelease();

const nav = [
  { href: "/coach", label: "Coach" },
  { href: "/labours", label: "Labours" },
  { href: "/guide/", label: "Guide" },
  { href: "/changelog/", label: "Changelog" },
];
const current = (href: string) =>
  path === href || (href.endsWith("/") && path.startsWith(href)) ? "page" : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={icon.src} />
    <link rel="alternate" type="application/rss+xml" title="Heracles Records releases" href="/changelog.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Heracles Records" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <img src={icon.src} alt="" width="28" height="28" />
          Heracles Records
        </a>
        <nav class="site-nav" aria-label="Site">
          {nav.map((item) => <a href={item.href} aria-current={current(item.href)}>{item.label}</a>)}
        </nav>
        <a class="button primary header-download" href="/download" aria-current={current("/download")}>
          Download
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Footer">
          <a href="/download">Download</a>
          <a href="/guide/">Guide</a>
          <a href="/guide/faq">FAQ</a>
          <a href="/changelog/">Changelog</a>
          <a href="/about">About</a>
          <a href={repo}>GitHub</a>
          <a href={`${repo}/issues/new`}>Report an issue</a>
          <a href="/privacy.html">Privacy policy</a>
          <a href="https://buymeacoffee.com/quochungse">Buy me a coffee</a>
        </nav>
        {
          release && (
            <p>
              Version {release.version} · {formatReleaseDate(release.publishedAt)} ·{" "}
              <a href="/changelog/">What's new</a>
            </p>
          )
        }
        <p>
          Heracles Records is an independent, unofficial app. It is not made, endorsed or
          supported by COROS. COROS is a trademark of COROS Wearables, Inc.
        </p>
      </div>
    </footer>
  </body>
</html>
